{
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Principal": {
                    "Federated": "arn:{{ oidc_provider_arn }}"
                },
                "Action": "sts:AssumeRoleWithWebIdentity",
                "Condition": {
                    "StringEquals": {
                        "{{ oidc_provider_arn.split('oidc-provider/')[1] }}:sub": [
    {% for ocp_sa in ocp_comp_sa_list %}
    {% if ocp_sa is defined and ocp_sa != "" and ocp_sa != 'default' %}
    {% if (loop.index0 + 1) < ocp_comp_sa_list | length %}
                            "system:serviceaccount:{{ ocp_comp_ns }}:{{ ocp_sa }}",
    {% else %}
                            "system:serviceaccount:{{ ocp_comp_ns }}:{{ ocp_sa }}"
    {% endif %}
    {% endif %}
    {% endfor %}
                        ]
                    }
                }
            }
        ]
}
